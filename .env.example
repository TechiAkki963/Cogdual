# Public site URL used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://cogdual.com

# Cloudflare Turnstile. Required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend. Verify your sending domain before launch.
RESEND_API_KEY=
RESEND_FROM="Cogdual Careers <careers@cogdual.com>"

# Private S3 bucket for candidate resumes.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Upstash Redis for distributed rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32+ random bytes; signs the short-lived application submission token.
UPLOAD_SIGNING_SECRET=
